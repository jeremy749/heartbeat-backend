# Copy to .env (or set these in your host's dashboard) and adjust.
# Everything here has a working default, so none of it is required to run locally.

# Shared secret the device/classifier sends as X-Device-Key to POST beats.
# Leave unset and one is generated on first run and printed at startup.
DEVICE_API_KEY=

# Extra sites allowed to call the API, comma-separated. localhost dev ports and
# *.netlify.app are always allowed.
CORS_ORIGINS=https://heartbeat.example.com

# Where the SQLite file lives.
HEARTBEAT_DB=heartbeat.db

# How long a session token stays valid, in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Sign-in throttle: this many failures for one name+address within the window
# blocks further attempts until they age out.
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=300

# Retention. Waveforms are the bulky part of a beat (~1.5 KB each), and only the
# recent-strip view reads them, so they are dropped well before the beats are.
# 0 disables either sweep.
SAMPLE_RETENTION_HOURS=24
BEAT_RETENTION_DAYS=0

# How often the retention sweep runs, in seconds.
RETENTION_INTERVAL_SECONDS=3600

# How long a download/socket ticket stays valid, in seconds. Tickets are what
# travel in a URL instead of the session token, and they are single-use.
TICKET_TTL_SECONDS=60

# Rebuild the demo account's recording at startup when it has no readings.
# Meant for a host with an ephemeral disk, where the database is empty again
# after every cold start. Off unless set.
SEED_DEMO=
DEMO_BEATS=720
